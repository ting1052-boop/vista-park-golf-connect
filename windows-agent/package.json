{
    "name":  "vista-windows-agent",
    "private":  true,
    "version":  "0.8.0",
    "description":  "Windows bay agent for VISTA Park Golf Connect",
    "main":  "electron-main.js",
    "scripts":  {
                    "start":  "electron .",
                    "start:overlay":  "electron .",
                    "start:legacy":  "node vista-agent.js",
                    "check":  "node --check vista-agent.js \u0026\u0026 node --check electron-main.js \u0026\u0026 node --check electron-preload.js \u0026\u0026 node --check renderer/renderer.js \u0026\u0026 node game-log-probe.test.js \u0026\u0026 node screen-golf-monitor.test.js \u0026\u0026 node screen-hole-detector.test.js \u0026\u0026 node round-event-outbox.test.js",
                    "dist":  "electron-builder --win dir --config.win.signAndEditExecutable=false",
                    "dist:portable":  "electron-builder --win portable --config.win.signAndEditExecutable=false",
                    "dist:installer":  "electron-builder --win nsis --config.win.signAndEditExecutable=false"
                },
    "engines":  {
                    "node":  "\u003e=18"
                },
    "devDependencies":  {
                            "electron":  "^31.0.0",
                            "electron-builder":  "^24.13.3"
                        },
    "build":  {
                  "appId":  "com.vista.bayagent",
                  "productName":  "VISTA Bay Agent",
                  "files":  [
                                "electron-main.js",
                                "agent-config.js",
                                "game-log-probe.js",
                                "screen-golf-monitor.js",
                                "screen-hole-detector.js",
                                "round-event-outbox.js",
                                "hole-ocr.ps1",
                                "monitor.config.example.json",
                                "electron-preload.js",
                                "renderer/**",
                                "screens/**",
                                "bays.config.json",
                                "bays.config.local.example.json"
                            ],
                  "directories":  {
                                      "output":  "dist"
                                  },
                  "win":  {
                              "target":  [
                                             "portable",
                                             "nsis"
                                         ]
                          },
                  "portable":  {
                                   "artifactName":  "VISTA-Bay-Agent.exe"
                               },
                  "nsis":  {
                               "oneClick":  true,
                               "perMachine":  true,
                               "allowToChangeInstallationDirectory":  false,
                               "createDesktopShortcut":  false,
                               "createStartMenuShortcut":  true,
                               "runAfterFinish":  true,
                               "include":  "installer.nsh",
                               "artifactName":  "VISTA-Bay-Agent-Setup-${version}.exe"
                           }
              }
}
