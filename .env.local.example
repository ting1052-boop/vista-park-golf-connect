NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000
IOT_WEBHOOK_SECRET=
CRON_SECRET=
DEVICE_WEBHOOK_URL=
HOME_ASSISTANT_URL=http://homeassistant.local:8123
HOME_ASSISTANT_TOKEN=

# 입구 키오스크 API 보호용 키입니다.
# 설정하면 태블릿에서 /kiosk/entrance?key=<값>으로 1회 접속해 등록해야 합니다.
# 비워두면 개발용으로 개방됩니다.
KIOSK_ACCESS_KEY=

# Store-local controller. Keep the actual token only on the HA Windows laptop
# and in Vercel Production environment variables.
STORE_CONTROLLER_ENABLED=false
STORE_CONTROLLER_TOKEN=

# HH 골프 PC 세팅 도구가 /api/pc-setup/* 를 호출할 때 쓰는 등록 토큰.
# 복제 이미지에 굽지 않는다. 운영자가 세팅 도구 실행 시 직접 입력한다.
# 비워두면 모든 등록 요청이 401 로 거절된다(fail-closed).
PC_SETUP_TOKEN=
